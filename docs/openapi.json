{
  "openapi": "3.1.0",
  "info": {
    "title": "Instagram Edits internal API — research reference",
    "version": "0.2.1",
    "description": "Unofficial reference, not affiliated with Meta. Nine read operations exercised on one consenting account on 2026-10-18. Comment analysis returned null; Kits was empty. One real POST endpoint with named persisted-query examples. No public REST gateway is provided. Credentials must stay in your backend."
  },
  "servers": [
    {
      "url": "https://i.instagram.com",
      "description": "Host used in recorded live checks"
    }
  ],
  "security": [
    {
      "InstagramSession": []
    }
  ],
  "paths": {
    "/graphql_www": {
      "post": {
        "operationId": "executePersistedInstagramQuery",
        "summary": "Execute a named persisted read query",
        "description": "Choose a request example. Friendly-name and document-ID headers must match its form fields. variables is a JSON string. For operational calls use the Python SDK: it handles aliases, NDJSON, ownership and response validation. Examples contain synthetic account/media IDs.",
        "parameters": [
          {
            "name": "User-Agent",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "Instagram 1.0 Android",
            "description": "Tested fallback client profile."
          },
          {
            "name": "X-IG-App-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "954255173121948",
            "description": "Edits application ID."
          },
          {
            "name": "IG-INTENDED-USER-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "999",
            "description": "Current session user ID; example is synthetic."
          },
          {
            "name": "IG-U-DS-USER-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "999",
            "description": "Current session user ID; example is synthetic."
          },
          {
            "name": "X-FB-Friendly-Name",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "BaselReelDetailsQuery",
            "description": "Must match fb_api_req_friendly_name in the form."
          },
          {
            "name": "X-Client-Doc-Id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "3261342854360971614358769315",
            "description": "Must match client_doc_id in the form."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/GraphQLForm"
              },
              "examples": {
                "BaselReelDetailsQuery": {
                  "summary": "BaselReelDetailsQuery",
                  "description": "62 retention points and Reel metrics returned. IDs in this example are synthetic.",
                  "value": {
                    "method": "post",
                    "pretty": "false",
                    "format": "json",
                    "server_timestamps": "true",
                    "locale": "user",
                    "fb_api_req_friendly_name": "BaselReelDetailsQuery",
                    "purpose": "fetch",
                    "enable_canonical_naming": "true",
                    "enable_canonical_variable_overrides": "true",
                    "enable_canonical_naming_ambiguous_type_prefixing": "true",
                    "client_doc_id": "3261342854360971614358769315",
                    "variables": "{\"media_id\":\"12345\",\"include_creative_tools\":false}"
                  }
                },
                "BaselPublicInsightsQuery": {
                  "summary": "BaselPublicInsightsQuery",
                  "description": "Public metric counts and rates returned for the owned Reel. IDs in this example are synthetic.",
                  "value": {
                    "method": "post",
                    "pretty": "false",
                    "format": "json",
                    "server_timestamps": "true",
                    "locale": "user",
                    "fb_api_req_friendly_name": "BaselPublicInsightsQuery",
