include README.md README.en.md PYPI_README.md LICENSE CONTRIBUTING.md SECURITY.md CHANGELOG.md REPOSITORY.md
recursive-include docs *.md *.json *.html *.css *.js *.txt LICENSE NOTICE
recursive-include examples *.py
recursive-include tests *.py *.json
recursive-include tools *.py
recursive-include .github *.yml
global-exclude __pycache__ *.py[cod]
